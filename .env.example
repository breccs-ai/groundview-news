# Ground View News — environment variables (copy to .env.local)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_IDENTITY_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

OPENAI_API_KEY=
RESEND_API_KEY=

ADMIN_PASSWORD=
CRON_SECRET=
VALIDATE_AD_SECRET=

# Salt used to hash application IP addresses before rate-limit storage.
WRITER_RATE_LIMIT_SECRET=replace-with-a-long-random-secret

# Salt used to hash contact/advertising-enquiry IP addresses before rate-limit storage.
# Falls back to WRITER_RATE_LIMIT_SECRET if unset.
CONTACT_RATE_LIMIT_SECRET=replace-with-a-long-random-secret
